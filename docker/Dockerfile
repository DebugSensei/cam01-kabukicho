# Только отдача готовых страниц. Пайплайн внутрь НЕ заворачивается: он требует
# CUDA и весов, образ раздулся бы на гигабайты без пользы для просмотра.
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

# out/ монтируется томом, а не копируется: страницы перегенерируются на хосте
# и должны появляться в контейнере без пересборки образа.
EXPOSE 80
