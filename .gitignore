# Правило 9 (приватность): сырое видео и кропы наружу не уезжают.
# Шаблон вида dir/* , а не dir/ : иначе git не пускает обратно даже .gitkeep
# и структура каталогов не переживает клон.
raw/*
evidence/*
*.ts
*.mp4
*.mkv

# Веса моделей — не в git, они фиксируются по sha256 в run_manifest.json (правило 6).
*.pt
*.onnx
*.engine

# Артефакты прогонов. Это не исходники: они пересобираются из raw/ + configs/.
out/*

# ДВЕ СТРАНИЦЫ ДЛЯ GITHUB PAGES, поимённо. Не `out/` целиком и не по маске
# *.html: маска втянула бы replay.html вместе с ссылкой на локальный mp4,
# а папка — весь архив пруфов.
#
# Что НЕ публикуется и почему — docs/DECISIONS.md, раздел 12. Коротко:
# размытие лица не делает кроп неперсональным. Одежда, спутники, точное
# время и место в сумме идентифицируют человека, а публичный
# индексируемый URL с кропами прохожих на японской улице — риск по APPI,
# несоразмерный пользе. Публикуется минимум, достаточный для проверки
# методологии: 12 кадров на витрину, 48 всего.
!out/dashboard.html
!out/benchmark.html

det/*
track/*
pose/*
attn/*
attr/*
calib/*
zones/*
# ДВА ИСКЛЮЧЕНИЯ. Остальное в calib/ и zones/ — выходы стадий, они
# пересоздаются. Эти два не пересоздаются никем:
#
#   zones/zones.json      обводка витрин и ROI, двадцать кликов человека.
#                         Её производит только scripts/pick_zones.py вручную.
#   calib/homography.json геометрия, на которой стоит каждый метр в отчёте.
#                         Формально её пишет S1, фактически повторный прогон
#                         даёт другую: S1 берёт выборку из det/frames.parquet,
#                         а S3 перезаписал этот файл другим материалом
#                         (замер: фокус 947 px против 1030). Восстановить
#                         опубликованную геометрию можно только из этого файла.
#
# Обе — провенанс результата, а не промежуточные данные. Персональных данных
# в них нет: координаты витрин и два массива обезличенных ростов и глубин.
!zones/zones.json
!calib/homography.json

# Манифест прогона отслеживается. Правило 6 существует ровно для того, чтобы
# «используется YOLO» не было ответом: имя весов, их sha256, разрешение входа,
# device, precision и версии библиотек. Без файла в репозитории проверить это
# нечем, а docs/DECISIONS.md прямо называет манифест источником своих чисел.
# Персональных данных в нём нет: имена витрин, shа конфигов, тайминги, версии.
!run_manifest.json

# Но структура каталогов должна пережить клон — иначе этапы упадут на mkdir.
!raw/.gitkeep
!evidence/.gitkeep
!out/.gitkeep
!det/.gitkeep
!track/.gitkeep
!pose/.gitkeep
!attn/.gitkeep
!attr/.gitkeep
!calib/.gitkeep
!zones/.gitkeep

# Кривая присутствия по дню — обоснование выбора часа. Идёт в отчёт, значит
# должна лежать в репозитории вместе с кодом, который её построил.
!out/density.csv
!out/density.png
!out/density_meta.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Снимок артефактов на время параллельной разметки — не исходник.
snapshot_morning/

# Картинки README собираются scripts/make_readme_figures.py из артефактов,
# но в репозиторий кладутся: без них README нечитаем на GitHub.
!docs/img/
!docs/img/*.webp

# Скриншоты оверлея — тяжёлые jpg, в репозиторий не идут.
out/overlay_frames/
